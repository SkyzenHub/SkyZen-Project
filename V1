-- ===== Pencatat =====
local lines, paused = {}, false

local function ser(v, d)
    d = d or 0
    local t = typeof(v)
    if t == "string" then return '"' .. v .. '"'
    elseif t == "Instance" then return v:GetFullName()
    elseif t == "table" then
        if d > 2 then return "{...}" end
        local p = {}
        for k, x in pairs(v) do
            p[#p + 1] = "[" .. tostring(k) .. "]=" .. ser(x, d + 1)
        end
        return "{" .. table.concat(p, ", ") .. "}"
    end
    return tostring(v)
end

local function log(tag, text)
    if paused then return end
    local line = string.format("[%s] %s %s", os.date("%H:%M:%S"), tag, text)
    lines[#lines + 1] = line
    local l = Instance.new("TextLabel", scroll)
    l.Size = UDim2.new(1, -6, 0, 0)
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.BackgroundTransparency = 1
    l.TextWrapped = true
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextColor3 = Color3.new(1, 1, 1)
    l.TextSize = 13
    l.Text = line
    if #lines > 300 then
        table.remove(lines, 1)
        scroll:FindFirstChildOfClass("TextLabel"):Destroy()
    end
    scroll.CanvasPosition = Vector2.new(0, 99999)
end

toggle.MouseButton1Click:Connect(function() panel.Visible = not panel.Visible end)
clearB.MouseButton1Click:Connect(function()
    lines = {}
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
end)
copyB.MouseButton1Click:Connect(function()
    if setclipboard then setclipboard(table.concat(lines, "\n")) end
end)
pauseB.MouseButton1Click:Connect(function()
    paused = not paused
    pauseB.Text = paused and "Lanjut" or "Jeda"
end)

-- 1. Tombol UI yang kamu tekan
local hooked = {}
local function hookButton(b)
    if hooked[b] or b:IsDescendantOf(gui) then return end
    hooked[b] = true
    b.Activated:Connect(function()
        log("TOMBOL", b:GetFullName())
    end)
end
local function scanUI(root)
    for _, o in ipairs(root:GetDescendants()) do
        if o:IsA("TextButton") or o:IsA("ImageButton") then hookButton(o) end
    end
    root.DescendantAdded:Connect(function(o)
        if o:IsA("TextButton") or o:IsA("ImageButton") then hookButton(o) end
    end)
end
scanUI(lp:WaitForChild("PlayerGui"))

-- 2. Remote yang dikirim ke server
local old
old = hookmetamethod(game, "__namecall", function(self, ...)
    local m = getnamecallmethod()
    if (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance" then
        local args = table.pack(...)
        local parts = {}
        for i = 1, args.n do parts[i] = ser(args[i]) end
        log("KIRIM", self:GetFullName() .. " " .. m .. " (" .. table.concat(parts, ", ") .. ")")
    end
    return old(self, ...)
end)

-- 3. Remote yang diterima dari server
local function hookRemote(r)
    if r:IsA("RemoteEvent") then
        r.OnClientEvent:Connect(function(...)
            local args = table.pack(...)
            local parts = {}
            for i = 1, args.n do parts[i] = ser(args[i]) end
            log("TERIMA", r:GetFullName() .. " (" .. table.concat(parts, ", ") .. ")")
        end)
    end
end
for _, o in ipairs(game:GetDescendants()) do pcall(hookRemote, o) end
game.DescendantAdded:Connect(function(o) pcall(hookRemote, o) end)

