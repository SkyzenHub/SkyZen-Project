        state = not state
        track.BackgroundColor3 = state and PINK or OFFTRACK
        knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        s.Color = state and PINK or WHITE
        s.Transparency = state and 0.3 or 0.88
        pcall(cb, state)
    end)
end

