-- ===== helper =====
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) new("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function stroke(o, col, tr) return new("UIStroke", {Color = col, Transparency = tr or 0, Thickness = 1}, o) end
local function label(parent, text, size, color, font, x)
    return new("TextLabel", {
        BackgroundTransparency = 1, Text = text, TextSize = size, TextColor3 = color,
        Font = font or Enum.Font.GothamBold, TextXAlignment = x or Enum.TextXAlignment.Left,
    }, parent)
end

