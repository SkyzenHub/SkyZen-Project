-- FITUR AUTO FARM BERDASARKAN LOG
------------------------------------------------------------
local FARM = {Attack = false, SkillE = false, SkillR = false}

local function getCastRemote()
    local folder = RS:FindFirstChild("Remotes")
    if folder then
        return folder:FindFirstChild("Cast")
    end
    return nil
end

local function fireCast(skill)
    local remote = getCastRemote()
    local c = lp.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if remote and hrp then
        local p = hrp.Position
        remote:FireServer(skill, p.X, p.Y, p.Z, nil)
    end
end

local farmPanel = panel(farmPage, "01", "Auto Combat", "REMOTE ENGINE")
toggleRow(farmPanel, "Auto Attack", function(v) FARM.Attack = v end)
toggleRow(farmPanel, "Auto Skill E", function(v) FARM.SkillE = v end)
toggleRow(farmPanel, "Auto Skill R", function(v) FARM.SkillR = v end)

-- Looping otomatis berdasarkan data remote Cast dari log
task.spawn(function()
    while task.wait(0.25) do
        if FARM.Attack then pcall(fireCast, "attack") end
    end
end)
task.spawn(function()
    while task.wait(1) do
        if FARM.SkillE then pcall(fireCast, "E") end
        if FARM.SkillR then pcall(fireCast, "R") end
    end
end)

