local SETTINGS = {
    AutoClick = false,
    Attack = false,
    SkillE = false,
    SkillR = false,
    Rebirth = false,
    BestPet = false,
}

local remotesFolder = RS:FindFirstChild("Remotes")

local function getRemote(name)
    if remotesFolder then
        return remotesFolder:FindFirstChild(name)
    end
    return nil
end

-- Fungsi pencarian target musuh terdekat di Workspace (jika ada folder musuh/mobs)
local function getNearestTarget()
    local mobsFolder = workspace:FindFirstChild("Mobs") or workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Wave")
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local closestTarget = nil
    local shortestDist = math.huge

    if mobsFolder then
        for _, mob in ipairs(mobsFolder:GetDescendants()) do
            if mob:IsA("Model") and mob:FindFirstChild("HumanoidRootPart") then
                local dist = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = mob
                end
            end
        end
    end
    return closestTarget
end

local function fireCast(skill)
    local castRemote = getRemote("Cast")
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if castRemote and hrp then
        local p = hrp.Position
        local target = getNearestTarget()
        local targetId = nil
        if target and target:FindFirstChild("ID") then
            targetId = target.ID.Value
        end

        pcall(function()
            -- Mengirimkan skill dengan koordinat dan target jika ditemukan
            castRemote:FireServer(skill, p.X, p.Y, p.Z, targetId)
        end)
    end
end

