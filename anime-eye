local function getRemote(name)
    for _, v in ipairs(RS:GetDescendants()) do
        if v.Name == name and (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) then
            return v
        end
    end
    return nil
end

local function sendCast(actionName)
    local castRemote = getRemote("Cast")
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if castRemote and hrp then
        pcall(function()
            castRemote:FireServer(actionName, hrp.Position)
        end)
    end
end

