local function createTabButton(name, targetPage)
    local btn = new("TextButton", {
        Size = UDim2.new(0.5, -3, 1, 0), BackgroundColor3 = INPUT,
        Text = name, TextSize = 11, Font = Enum.Font.GothamBold, TextColor3 = MUTED,
    }, tabBar)
    corner(btn, 6)
    stroke(btn, WHITE, 0.88)

    btn.MouseButton1Click:Connect(function()
        page1.Visible = (targetPage == 1)
        page2.Visible = (targetPage == 2)
        for _, child in ipairs(tabBar:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = INPUT
                child.TextColor3 = MUTED
            end
        end
        btn.BackgroundColor3 = PINK
        btn.TextColor3 = WHITE
    end)
    return btn
end

