-- remote yang dikirim ke server (hook aman)
if hookmetamethod and newcclosure and getnamecallmethod then
    local setnm = setnamecallmethod
    local old
    old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local m = getnamecallmethod()
        if (m == "FireServer" or m == "InvokeServer") and not (checkcaller and checkcaller()) then
            local args = table.pack(...)
            local obj = self
            task.defer(function()
                pcall(function()
                    if typeof(obj) == "Instance" then
                        push("KIRIM", obj:GetFullName() .. " " .. m .. " (" .. packArgs(args) .. ")", obj.Name)
                    end
                end)
            end)
        end
        if setnm then setnm(m) end
        return old(self, ...)
    end))
else
    push("INFO", "Executor tidak mendukung hookmetamethod: log KIRIM tidak aktif.")
end

-- remote yang diterima dari server
local function hookRemote(r)
    if r:IsA("RemoteEvent") then
        r.OnClientEvent:Connect(function(...)
            local args = table.pack(...)
            pcall(function()
                push("TERIMA", r:GetFullName() .. " (" .. packArgs(args) .. ")", r.Name)
            end)
        end)
    end
end
for _, o in ipairs(game:GetDescendants()) do pcall(hookRemote, o) end
game.DescendantAdded:Connect(function(o) pcall(hookRemote, o) end)
