local FarmRemotes = nil

local function getFarmRemotes()
    if FarmRemotes then return FarmRemotes end
    local folder = RS:FindFirstChild("Remotes")
    if not folder then return nil end
    local cast = folder:FindFirstChild("Cast")
    local train = folder:FindFirstChild("Train")
    local ps = folder:FindFirstChild("PrivateState")
    if cast and train and ps then
        FarmRemotes = {Cast = cast, Train = train}
        ps.OnClientEvent:Connect(function(data)
            if type(data) == "table" then
                for k, v in pairs(data) do FarmState[k] = v end
            end
        end)
    end
    return FarmRemotes
end

local function farmCast(skill)
    local r = getFarmRemotes()
    local c = lp.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if r and hrp then
        local p = hrp.Position
        r.Cast:FireServer(skill, p.X, p.Y, p.Z)
    end
end

