local hooked = {}
local function hookButton(b)
    if hooked[b] or b:IsDescendantOf(gui) then return end
    hooked[b] = true
    b.Activated:Connect(function() push("TOMBOL", b:GetFullName()) end)
end
local function scanUI(root)
    for _, o in ipairs(root:GetDescendants()) do
        if o:IsA("TextButton") or o:IsA("ImageButton") then hookButton(o) end
    end
    root.DescendantAdded:Connect(function(o)
        if o:IsA("TextButton") or o:IsA("ImageButton") then hookButton(o) end
    end)
end
