local MAX_LINES = 200
local queue, lines, labels = {}, {}, {}
local paused = false
local hideNoisy = true
local NOISY = {Fx = true, Train = true}

local function ser(v, d)
    d = d or 0
    local t = typeof(v)
    if t == "string" then return '"' .. v .. '"'
    elseif t == "Instance" then return v:GetFullName()
    elseif t == "table" then
        if d > 2 then return "{...}" end
        local p = {}
        for k, x in pairs(v) do
            p[#p + 1] = "[" .. tostring(k) .. "]=" .. ser(x, d + 1)
        end
        return "{" .. table.concat(p, ", ") .. "}"
    end
    return tostring(v)
end
local function packArgs(args)
    local parts = {}
    for i = 1, args.n do
        local ok, r = pcall(ser, args[i])
        parts[i] = ok and r or "?"
    end
    return table.concat(parts, ", ")
end
local function push(tag, text, remoteName)
    if paused then return end
    if hideNoisy and remoteName and NOISY[remoteName] then return end
    queue[#queue + 1] = string.format("[%s] %s %s", os.date("%H:%M:%S"), tag, text)
end

task.spawn(function()
    while task.wait(0.4) do
        if #queue > 0 and pages["LOG"].Visible then
            local batch = queue
            queue = {}
            for _, line in ipairs(batch) do
                lines[#lines + 1] = line
                local l = new("TextLabel", {
                    Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                    TextColor3 = Color3.fromRGB(225, 220, 228), TextSize = 11, Font = Enum.Font.Code, Text = line,
                }, logScroll)
                labels[#labels + 1] = l
            end
            while #lines > MAX_LINES do
                table.remove(lines, 1)
                table.remove(labels, 1):Destroy()
            end
            logScroll.CanvasPosition = Vector2.new(0, 99999)
        elseif #queue > 400 then
            queue = {}
        end
    end
end)

clearB.MouseButton1Click:Connect(function()
