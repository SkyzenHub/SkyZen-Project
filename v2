local function panel(page, step, titleText, tag)
    local f = new("Frame", {Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = PANEL}, page)
    corner(f, 10)
    stroke(f, WHITE, 0.88)
    new("UIPadding", {PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, f)
    new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, f)
    local head = new("Frame", {Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = 0}, f)
    local st = new("Frame", {Size = UDim2.new(0, 26, 0, 20), Position = UDim2.new(0, 0, 0, 2), BackgroundTransparency = 1}, head)
    stroke(st, PINK, 0.4)
    local stT = label(st, step, 11, PINK, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
    stT.Size = UDim2.new(1, 0, 1, 0)
    local tt = label(head, titleText, 14, WHITE, Enum.Font.GothamBold)
    tt.Position = UDim2.new(0, 34, 0, 0)
    tt.Size = UDim2.new(1, -100, 1, 0)
    local tg = label(head, tag, 7, MUTED, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    tg.Position = UDim2.new(1, -90, 0, 0)
    tg.Size = UDim2.new(0, 90, 1, 0)
    return f
end

local function toggleRow(parentFrame, name, cb)
    local state = false
    local b = new("TextButton", {Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = INPUT, Text = "", AutoButtonColor = false, LayoutOrder = 1}, parentFrame)
    corner(b, 8)
    local s = stroke(b, WHITE, 0.88)
    local t = label(b, name, 12, WHITE)
    t.Position = UDim2.new(0, 10, 0, 0)
    t.Size = UDim2.new(1, -60, 1, 0)
    local track = new("Frame", {Size = UDim2.new(0, 34, 0, 18), Position = UDim2.new(1, -44, 0.5, -9), BackgroundColor3 = OFFTRACK}, b)
    corner(track, 9)
    local knob = new("Frame", {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 2, 0.5, -7), BackgroundColor3 = WHITE}, track)
    corner(knob, 7)
    b.MouseButton1Click:Connect(function()
        state = not state
        track.BackgroundColor3 = state and PINK or OFFTRACK
        knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        s.Color = state and PINK or WHITE
        s.Transparency = state and 0.3 or 0.88
        pcall(cb, state)
    end)
end

